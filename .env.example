# Copy to .env and fill in a real value. Both vars must be the SAME secret —
# PERSIST_API_KEY is checked by the server at runtime, VITE_PERSIST_API_KEY is
# baked into the browser bundle at build time so the web client can send it.
# Generate one with: openssl rand -hex 32

PERSIST_API_KEY=
VITE_PERSIST_API_KEY=
